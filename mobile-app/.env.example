# Copy to .env (this file is safe to commit):
#   cp .env.example .env

# Backend API URL (LAN IP for physical devices; localhost for simulators)
EXPO_PUBLIC_API_URL=http://192.168.1.42:5000

# Google Maps SDK key used by map rendering
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Optional Google Sign-In OAuth client IDs (recommended for auth)
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

EXPO_PUBLIC_DEV_MODE=false
