# Copy to .env first:
#   cp .env.example .env

# Docker (used by docker-compose.yaml)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=cityquest
MYSQL_USER=cityquest
MYSQL_PASSWORD=password

# Backend app (used by Node/Express)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=cityquest
PORT=5000

# Auth (backend-issued JWT)
JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-long-random-string
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Comma-separated local user IDs allowed to create/edit content.
ADMIN_USER_IDS=

# Development-only escape hatches. Keep false in production.
ALLOW_DEV_EMAIL_AUTH=false
ALLOW_DEV_QUEST_SOLVE=false

# Optional comma-separated CORS origins. Leave empty for local/mobile development.
CORS_ORIGIN=
